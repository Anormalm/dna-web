# Server-only configuration. Copy to a private admin.env outside the repository.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DNA_ADMIN_GITHUB_IDS=
DNA_ADMIN_ORIGIN=https://dna.example.org
DNA_ADMIN_STATE_DIR=/private/dna-admin
DNA_ADMIN_RUN_DIR=/private/galaxy-enrollment
# Explicit opt-in for private development only; use HTTPS in production.
DNA_ADMIN_ALLOW_HTTP=false
